<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- Simple Header (no drawer) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_header"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_button"
            android:contentDescription="رجوع"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/header_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWarehouseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مخزون المخزن"
                android:textColor="@color/header_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWarehouseLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="عمران هايبر"
                android:textColor="@color/header_subtext"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStockItemCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 صنف"
            android:textColor="@color/header_subtext"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_secondary"
            android:contentDescription="بحث" />

        <EditText
            android:id="@+id/etSearchStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@android:color/transparent"
            android:hint="ابحث عن منتج..."
            android:inputType="text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Stock List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWarehouseStock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyStock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="لا يوجد مخزون في هذا المخزن"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
