<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_tile_card"
    android:elevation="2dp"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Row 1: Icon, Title & Amount -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCustomerLedgerIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_search_bar"
            android:gravity="center"
            android:text="🛒"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCustomerLedgerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="فاتورة مبيعات #24"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCustomerLedgerDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="📅 2025-02-23 11:30"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCustomerLedgerAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ 500.00 ر.ي"
            android:textColor="@color/danger"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2: Notes & Running Balance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCustomerLedgerNotes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="ملاحظات: سداد آجل"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCustomerLedgerRunningBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_bar"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="📊 الرصيد بعدها: 1,500.00 ر.ي"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
