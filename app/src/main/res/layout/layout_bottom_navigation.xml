<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavigation"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_alignParentBottom="true"
    android:background="@color/bg_card"
    android:elevation="12dp"
    android:orientation="vertical"
    android:layoutDirection="rtl">

    <!-- Top subtle divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_color" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Tab 1: الرئيسية -->
        <LinearLayout
            android:id="@+id/bottomNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivBottomNavHomeIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvBottomNavHomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="الرئيسية"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 2: البيع POS -->
        <LinearLayout
            android:id="@+id/bottomNavPos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivBottomNavPosIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_pos"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvBottomNavPosText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="البيع"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 3: الفواتير -->
        <LinearLayout
            android:id="@+id/bottomNavInvoices"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivBottomNavInvoicesIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_receipt"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvBottomNavInvoicesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="الفواتير"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 4: المخزون (Products / Inventory) -->
        <LinearLayout
            android:id="@+id/bottomNavProducts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivBottomNavProductsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_box"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvBottomNavProductsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="المخزون"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 5: المزيد -->
        <LinearLayout
            android:id="@+id/bottomNavMore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/ivBottomNavMoreIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_more"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tvBottomNavMoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="المزيد"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
