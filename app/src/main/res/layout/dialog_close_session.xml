<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvExpectedCashClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="الكاش المتوقع: 0.00 ر.ي"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="المبلغ الفعلي في الدرج:"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etPhysicalCashClose"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center"
        android:hint="0.00"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etSessionCloseNotes"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="top|start"
        android:hint="ملاحظات الإغلاق (اختياري)"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textSize="13sp" />
</LinearLayout>
