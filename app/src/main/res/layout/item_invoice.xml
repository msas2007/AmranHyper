<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_tile_card"
    android:elevation="2dp"
    android:padding="14dp"
    android:layoutDirection="rtl">

    <!-- Top Row: Invoice # & Payment Status Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvInvoiceNum"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="📄 فاتورة #INV-1001"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInvoiceStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مدفوعة"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/success"
            android:background="@drawable/bg_badge_good_stock"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp" />

    </LinearLayout>

    <!-- Middle Row: Customer Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="العميل: "
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvInvoiceCustomer"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="عميل نقدي"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInvoiceNet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="150.00 ر.س"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Subtle divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/stroke_color"
        android:layout_marginVertical="6dp" />

    <!-- Bottom Row: Date & Action hint -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvInvoiceDate"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="🕒 2026-09-26 14:30"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="عرض الفاتورة والطباعة ›"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
